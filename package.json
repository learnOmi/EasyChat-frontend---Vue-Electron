    "pinia": "^3.0.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "sass-loader": "^16.0.5",
    "vite": "^7.0.5",
